diff --git a/src/spawn_players.c b/src/spawn_players.c
index a5e5d73..14e2c89 100644
--- a/src/spawn_players.c
+++ b/src/spawn_players.c
@@ -38,6 +38,44 @@ f32 gPlayerWaterLevel[8];
 s32 D_801652C0[8];
