 s16 D_80165300[8];
+
+// Psymatic: fill the empty 3P/4P versus slots with CPU racers (CVar gPsyCpuRacers, default off).
+// Latched at spawn so a menu change mid-race cannot desync spawning, ranking and rendering.
+static s32 sPsyCpuRacers = 0;
+
+s32 psy_cpu_racers_active(void) {
+    return sPsyCpuRacers && (gModeSelection == VERSUS) && (gPlayerCountSelection1 >= 3);
+}
+
+static void psy_spawn_cpu_racers(f32* arg0, f32* arg1, f32 arg2) {
+    s32 used[NUM_PLAYERS] = { 0 };
+    s32 pool[NUM_PLAYERS];
+    s32 poolCount = 0;
+    s32 character;
+    s32 pick;
+    s32 slot;
+    s32 i;
+
+    for (i = 0; i < gPlayerCountSelection1; i++) {
+        used[gCharacterSelections[i]] = 1;
+    }
+    for (i = 0; i < NUM_PLAYERS; i++) {
+        if (!used[i]) {
+            pool[poolCount++] = i;
+        }
+    }
+    for (slot = gPlayerCountSelection1; slot < NUM_PLAYERS; slot++) {
+        if (poolCount > 0) {
+            pick = random_int(poolCount);
+            character = pool[pick];
+            pool[pick] = pool[--poolCount];
+        } else {
+            character = random_int(NUM_PLAYERS);
+        }
+        spawn_player(&gPlayers[slot], slot, arg0[slot], arg1[slot], arg2, 32768.0f, character,
+                     PLAYER_EXISTS | PLAYER_CPU | PLAYER_START_SEQUENCE);
+    }
+}
 // Shadows values from gPathIndexByPlayerId, but is an array
