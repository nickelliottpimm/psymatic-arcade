+/* Psymatic Arcade: 1 = draw the native 4:3 image across the whole window with independent
+ * X and Y scales and no pillarbox, i.e. a 4:3 frame stretched to 16:9 for modulators that
+ * squeeze 16:9 back to 4:3. Overrides configWidescreen in gfx_pc.c. Defaults off. */
+unsigned int configStretch43 = 0;
+
+__attribute__((constructor))
+static void ge_stretch43_env_init(void)
+{
+    const char *e = getenv("GETV_STRETCH43");
+    if (e && *e >= '0' && *e <= '1' && e[1] == '\0') {
+        configStretch43 = (unsigned int) (*e - '0');
+    }
+}
