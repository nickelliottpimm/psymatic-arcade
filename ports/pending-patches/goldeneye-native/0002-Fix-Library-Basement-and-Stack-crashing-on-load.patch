From 78ff8c2c8b24a2878d99c17d45ec4bba753aad81 Mon Sep 17 00:00:00 2001
From: Claude <noreply@anthropic.com>
Date: Sat, 17 Oct 2026 17:36:05 +1100
Subject: [PATCH 2/5] Fix Library, Basement and Stack crashing on load

file_resource_table.inc.c maps "bg/bg_ame_all_p.seg" to
bg_imp_all_p_seg, a cut level with no data. gePortObsegSize() returns 0
for it, obLoadBGFileBytesAtOffset() copies nothing, and load_bg_file()
parses an uninitialised stack header: a random size each run, either
the "implausible background size" exit or SIGBUS in load_bg_file.
Point it at bg_ame_all_p_seg. Verified with GETV_STAGE=45/46/48
GETV_MP=2: size 8928, 240 frames, clean exit.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 getv/patches/0033-library-basement-stack-bg.patch | 13 +++++++++++++
 1 file changed, 13 insertions(+)
 create mode 100644 getv/patches/0033-library-basement-stack-bg.patch

diff --git a/getv/patches/0033-library-basement-stack-bg.patch b/getv/patches/0033-library-basement-stack-bg.patch
new file mode 100644
index 0000000..09bbe5a
--- /dev/null
+++ b/getv/patches/0033-library-basement-stack-bg.patch
@@ -0,0 +1,13 @@
+diff --git a/assets/obseg/file_resource_table.inc.c b/assets/obseg/file_resource_table.inc.c
+index 672ca38..fb6ea67 100644
+--- a/assets/obseg/file_resource_table.inc.c
++++ b/assets/obseg/file_resource_table.inc.c
+@@ -30,7 +30,7 @@ struct fileentry file_resource_table[] = {
+     {BG_IMP_ALL_P, "bg/bg_imp_all_p.seg", &bg_imp_all_p_seg},
+     {BG_ASH_ALL_P, "bg/bg_ash_all_p.seg", &bg_imp_all_p_seg},
+     {BG_LUE_ALL_P, "bg/bg_lue_all_p.seg", &bg_imp_all_p_seg},
+-    {BG_AME_ALL_P, "bg/bg_ame_all_p.seg", &bg_imp_all_p_seg},
++    {BG_AME_ALL_P, "bg/bg_ame_all_p.seg", &bg_ame_all_p_seg},
+     {BG_RIT_ALL_P, "bg/bg_rit_all_p.seg", &bg_rit_all_p_seg},
+     {BG_OAT_ALL_P, "bg/bg_oat_all_p.seg", &bg_oat_all_p_seg},
+     {BG_EAR_ALL_P, "bg/bg_ear_all_p.seg", &bg_ear_all_p_seg},
